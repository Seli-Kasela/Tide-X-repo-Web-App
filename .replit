modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "artifacts/api-server: API Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "3B4_FFSkEVBkAeYMFRJ2e"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run dev"
cwd = "./artifacts/api-server"
waitForPort = 8080
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "8080"

[[workflows.workflow]]
name = "artifacts/surf-triptide-x-bali-deck: web"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/surf-triptide-x-bali-deck"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/surf-triptide-x-bali-deck run dev"
cwd = "./artifacts/surf-triptide-x-bali-deck"
waitForPort = 22671
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "22671"
BASE_PATH = "/surf-triptide-x-bali-deck/"

[[workflows.workflow]]
name = "artifacts/mockup-sandbox: Component Preview Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "XegfDyZt7HqfW2Bb8Ghoy"
isCanvasWorkflow = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/mockup-sandbox run dev"
cwd = "./artifacts/mockup-sandbox"
waitForPort = 8081
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "8081"
BASE_PATH = "/__mockup"

[[workflows.workflow]]
name = "artifacts/surf-triptide-x-bali: web"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/surf-triptide-x-bali"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/surf-triptide-x-bali run dev"
cwd = "./artifacts/surf-triptide-x-bali"
waitForPort = 19998
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "19998"
BASE_PATH = "/"

[[workflows.workflow]]
name = "Google Connect Sync Application Content"
mode = "parallel"
author = 64282068

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Google Connect Sync Application Content"

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/surf-triptide-x-bali: web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/api-server: API Server"

[[workflows.workflow]]
name = "Seli Kasela "
mode = "sequential"
author = 64282068

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Google Connect Sync Application Content"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
